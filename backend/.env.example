# ScamGuard Backend Configuration Example
# 1. Get your free Gemini API key from https://aistudio.google.com/
# 2. Copy this file to .env and paste your key below:
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Google Safe Browsing API Key for live domain reputation lookups
SAFE_BROWSING_API_KEY=

# Gemini Model Identifier (e.g., gemini-3.6-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000
